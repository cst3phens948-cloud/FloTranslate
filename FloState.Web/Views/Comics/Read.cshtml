@model FloState.Web.Models.Comic
@{
  ViewData["Title"] = $"Read {Model.Title}";
}
<div class="reader-shell mx-auto max-w-[1440px] px-4 pb-20 pt-7 sm:px-8">
  <div class="mb-8 flex flex-wrap items-start justify-between gap-5">
    <div>
      <a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Project overview</a>
      <div class="eyebrow mt-7">CONTINUOUS READER</div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">@Model.Title</h1>
      <p class="mt-2 text-sm text-slate-400">@Model.SourceLanguage → @Model.TargetLanguage · @Model.Chapters.Sum(chapter => chapter.Pages.Count) pages</p>
    </div>
    <div class="reader-controls flex items-center gap-2 rounded-xl border border-slate-700/70 bg-slate-900/80 p-1.5" role="group" aria-label="Reader image version">
      <button type="button" class="reader-toggle active" data-reader-mode="translated" aria-pressed="true">Translated</button>
      <button type="button" class="reader-toggle" data-reader-mode="original" aria-pressed="false">Original</button>
    </div>
  </div>
  @if (Model.Chapters.Count == 0)
  {
    <div class="empty-panel">No chapters yet. Add one from the project overview.</div>
  }
  else
  {
    <div class="reader-layout grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside class="reader-index h-fit rounded-2xl border border-slate-800 bg-slate-900/70 p-4 lg:sticky lg:top-24">
        <div class="eyebrow mb-4">CHAPTERS</div>
        <nav aria-label="Chapter navigation" class="flex gap-2 overflow-x-auto lg:flex-col">
          @foreach (var chapter in Model.Chapters)
          {
            <a href="#chapter-@chapter.Id" class="reader-index-link"><span class="reader-index-number">@chapter.Number.ToString("00")</span><span class="truncate">@chapter.Title</span><span class="ml-auto text-xs text-slate-500">@chapter.Pages.Count</span></a>
          }
        </nav>
      </aside>
      <div class="min-w-0 space-y-16">
        @foreach (var chapter in Model.Chapters)
        {
          <section id="chapter-@chapter.Id" class="reader-chapter scroll-mt-24" aria-labelledby="chapter-title-@chapter.Id">
            <div class="reader-chapter-heading mb-5 flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-4">
              <div><div class="eyebrow">CHAPTER @chapter.Number.ToString("00")</div><h2 id="chapter-title-@chapter.Id" class="mt-2 text-2xl font-semibold tracking-tight text-white">@chapter.Title</h2></div>
              <span class="text-sm text-slate-400">@chapter.Pages.Count @(chapter.Pages.Count == 1 ? "page" : "pages")</span>
            </div>
            @if (chapter.Pages.Count == 0)
            {
              <div class="empty-panel">No pages uploaded in this chapter yet.</div>
            }
            else
            {
              <div class="reader-pages mx-auto max-w-[900px] space-y-5">
                @foreach (var page in chapter.Pages)
                {
                  var originalUrl = Url.Action("PageImage", "Comics", new { id = page.Id });
                  <figure class="reader-page overflow-hidden rounded-xl border border-slate-800 bg-slate-950 shadow-2xl shadow-black/30" data-original-url="@originalUrl" data-has-draft="@(!string.IsNullOrWhiteSpace(page.DraftJson) ? "true" : "false")" data-edit-url="@Url.Action("EditPage", "Comics", new { id = page.Id, readerSnapshot = 1 })">
                    <div class="reader-page-top flex items-center justify-between px-4 py-2 text-xs text-slate-400"><span>Page @(page.Number.ToString("00"))</span><span class="reader-page-status">@(!string.IsNullOrWhiteSpace(page.DraftJson) ? "Preparing translation" : "Original · not analyzed")</span></div>
                    <img src="@originalUrl" alt="@Model.Title, chapter @chapter.Number, page @(page.Number)" class="reader-image mx-auto block h-auto w-full" loading="lazy" />
                    <figcaption class="sr-only">Chapter @chapter.Number, page @(page.Number)</figcaption>
                  </figure>
                }
              </div>
            }
          </section>
        }
      </div>
    </div>
  }
</div>
@section Scripts
{
  <script src="~/js/reader.js" asp-append-version="true"></script>
}
