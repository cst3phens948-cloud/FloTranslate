@model FloState.Web.Models.Comic
@{ ViewData["Title"] = "New comic"; }
<div class="library narrow"><a asp-action="Index">← Library</a><h1>New comic</h1><form asp-action="Create" method="post" class="card stack"><div asp-validation-summary="ModelOnly"></div><label>Comic title<input asp-for="Title" required maxlength="160" /></label><label>Source language<input asp-for="SourceLanguage" required placeholder="e.g. Japanese" /></label><label>Target language<input asp-for="TargetLanguage" required placeholder="e.g. English" /></label><label>Context notes<textarea asp-for="Description" rows="4" placeholder="Premise, tone, or standing translation guidance"></textarea></label><button class="primary">Create comic</button></form></div>
